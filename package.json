{
  "name": "west-end",
  "private": true,
  "version": "0.0.0",
  "description": "London TypeScript's animation studio: characters rigged, animated and rendered in Godot, published as videos, posters and stills.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@londontypescript/temple-bar": "0.2.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
