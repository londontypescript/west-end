# Every pinned input of the west-end image except the Python wheels, which
# live in requirements.txt because pip reads its hashes from there.
#
# Format: one KEY=value per line, no quotes, no spaces, no shell expansion.
# container/build.sh reads this file, refuses a missing or malformed value,
# and passes each line to the build as --build-arg. Where each value came
# from, and how to update it, is in container/README.md.

# Base image: the multi-arch index digest of debian:bookworm-slim.
BASE_IMAGE=docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

# snapshot.debian.org timestamps. The debian one serves bookworm and
# bookworm-updates; the debian-security one serves bookworm-security.
SNAPSHOT_DEBIAN=20261027T143223Z
SNAPSHOT_DEBIAN_SECURITY=20261027T204336Z

# SHA-256 of each suite's InRelease at those timestamps. The build checks
# the files apt fetched against these, so a changed archive fails the build.
INRELEASE_BOOKWORM_SHA256=77737fa4b34f2693e982cc9ee35736816c35a7778fc2d326cc1bbf5b301fe1aa
INRELEASE_BOOKWORM_UPDATES_SHA256=5b16e36816b3b678bf8741c5bdc7f748f24bb4e8e3df23b79059414747e00170
INRELEASE_BOOKWORM_SECURITY_SHA256=a8201320a40fd8213991516946f76247cbade840cecfe31edb7e2702905b28ed

# Godot 4.7.2, Linux arm64.
GODOT_VERSION=4.7.2
GODOT_URL=https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_linux.arm64.zip
GODOT_ZIP=Godot_v4.7.2-stable_linux.arm64.zip
GODOT_ZIP_SHA512=dd59918da086bd49bde2f5450b5e567ff8650cbde9abbd7b8f4ca1197ff8c609baa38834666d032deafb47099078d7822279e2a0e06e5665745468f26533e7e2
GODOT_BINARY_SHA512=94a1da19f9a08b02f36061ab431173914cf502d76508fa6295dfe04c49bf0e0e53d44332a819c576fd8dad20dc4cdf3d9c21757411c07dac6edf259f4a7709f4

# Node 24, official linux-arm64 tarball.
NODE_VERSION=24.22.1
NODE_URL=https://nodejs.org/dist/v24.22.1/node-v24.22.1-linux-arm64.tar.xz
NODE_SHA256=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e

# gdUnit4, from the tag's source archive.
GDUNIT4_TAG=v6.2.2
GDUNIT4_COMMIT=0127a55f4543dfc24746f6e5c7ba6f94105d51f2
GDUNIT4_URL=https://github.com/godot-gdunit-labs/gdUnit4/archive/refs/tags/v6.2.2.tar.gz
GDUNIT4_SHA256=53ba53c23328d8f30205acc2f7ffe3d663773847d09b8f48edab1df6a5950571
